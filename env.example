# Discord bot token (discord.com/developers)
DISCORD_TOKEN=your_token_here

# ID kanala gdje se igraju igre
GAME_CHANNEL_ID=123456789012345678

# Sekundi pauze između igara (default 180 = 3 min)
GAME_INTERVAL=180

# Tvoj Discord user ID — ovaj nalog moze koristiti !invite i !stats
BOT_OWNER_ID=your_user_id_here
